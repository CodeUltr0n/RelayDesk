{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageDecision",
  "type": "object",
  "required": ["decision", "confidence", "evidence_ids", "rationale"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["ANSWER", "CLARIFY", "DUPLICATE", "ESCALATE"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}
